# RecMaestro 环境变量模板 —— 复制为 .env 并填入真实值
# 生产环境务必修改密码，勿用默认值

# MySQL
MYSQL_ROOT_PASSWORD=root123456
MYSQL_PASSWORD=root123456

# Redis（redis-server requirepass 即用此值；默认值仅供本地开发，生产务必改强密码）
REDIS_PASSWORD=redis123456

# JWT 签名密钥（必填，生产用随机长字符串）
JWT_SECRET=change-me-in-prod

# scheduler 与 worker 内部接口共享密钥（必填：scheduler 下发合并/删除/下载请求携带，
# worker 校验；未设置时两角色启动报错、内部接口拒绝全部请求）
INTERNAL_API_TOKEN=change-me-internal-token

# 首次启动创建的管理员初始密码
ADMIN_INITIAL_PASSWORD=admin123
